# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Compiler output / synthetic orgs
/tmp/tessera/
*.local

# Blueprint store (user-authored datasets, runtime data)
blueprints/
# Legacy SQLite run stores from older checkouts
runs.db

# React SPA (web/) — Node deps and build output
web/node_modules/
web/dist/
web/*.tsbuildinfo
# The SPA bundle Vite writes into the package for the wheel (built in CI, never committed)
src/tessera/data/web/

# Inspect logs (kept local) — except the holdout commitment + reveal, which are the
# published half of the ADR-0008 pre-registration protocol (docs/scaffold.md links them).
# gitignore cannot re-include below an ignored DIRECTORY, hence the star-then-negate dance.
logs/*
!logs/scaffold/
logs/scaffold/*
!logs/scaffold/holdout/
logs/scaffold/holdout/*
!logs/scaffold/holdout/COMMITMENT.json
!logs/scaffold/holdout/REVEAL.json
*.eval
# ...but keep the pinned demo logs the showcase depends on
!examples/*.eval
# ...and the bundled example runs that ship inside the wheel
!src/tessera/data/examples/**/*.eval
# ...and the committed leaderboard logs that back manifest rows (ADR-0012). Two ignores to
# beat here — the logs/* directory rule AND the global *.eval above — so re-include the
# directory first (star-then-negate), then re-include *.eval AFTER the global ignore so
# last-match-wins applies. Verify with: git check-ignore -v logs/leaderboard/x.eval
!logs/leaderboard/
logs/leaderboard/*
!logs/leaderboard/*.eval
!logs/leaderboard/README.md

# Private dev docs (superpowers specs/plans) — local only, kept out of the public repo
docs/superpowers/

# Local agent config and review artifacts (Claude Code, Lavish, omp)
.claude/
.lavish/
.omp/

# Secrets — API keys live here, never committed
.env
.env.*

# Local-only material: work logs, decks, explainer drafts, the MoA benchmark shim
local/
